{
  "name": "@antora-supplemental/facto-stack",
  "version": "0.2.24",
  "private": true,
  "description": "De-facto Antora stack composer + published stack demo: Valentus (lean) + Lunr + STEM + diagrams (client Mermaid / lightbox / SoftNav; Kroki optional)",
  "license": "MPL-2.0",
  "main": "lib/extension.js",
  "bin": {
    "facto-maint": "bin/facto-maint.js"
  },
  "exports": {
    ".": "./lib/extension.js",
    "./registry-meta": "./lib/registry-meta.js"
  },
  "files": [
    "lib/**/*",
    "bin/**/*",
    "playbook.fragment.yml",
    "README.adoc",
    "CHANGELOG.adoc",
    "LICENSE",
    "antora-registry.md"
  ],
  "scripts": {
    "build": "antora demo/playbook.yml",
    "build:demo": "antora demo/playbook.yml",
    "build:example": "antora examples/minimal-playbook.yml",
    "serve": "pnpm build && npx http-server build/site -p 8082 -o",
    "serve:demo": "pnpm build:demo && npx http-server build/site -p 8082 -o",
    "preview": "antora demo/playbook.yml",
    "diagrams:generate": "node scripts/generate-themed-diagrams.mjs",
    "diagrams:demo-plantuml": "node scripts/build-demo-plantuml.mjs",
    "diagrams:check": "node scripts/generate-themed-diagrams.mjs --check && node scripts/build-demo-plantuml.mjs --check",
    "maint:orphans": "orphan-finder --root ./demo/home --out ./build/orphan-finder",
    "maint:nav-drift": "nav-drift --root ./demo/home --require-in-nav --out ./build/nav-drift",
    "maint:stale": "stale-page --root ./demo/home --days 365 --out ./build/stale-page",
    "maint:pins": "playbook-pin-auditor --root . --playbook demo/playbook.yml",
    "maint:deep-links": "deep-link-contracts --config deep-link-contracts.yml --site-dir ./build/site",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@antora-supplemental/antora-search-chat": "github:antora-supplemental/antora-search-chat#v0.1.5",
    "@antora-supplemental/asciidoctor-emoji-literals": "github:antora-supplemental/asciidoctor-emoji-literals#main",
    "@antora-supplemental/build-stack": "github:antora-supplemental/build-stack#main",
    "@antora-supplemental/deep-link-contracts": "github:antora-supplemental/deep-link-contracts#v0.1.1",
    "@antora-supplemental/diagram-lightbox": "github:antora-supplemental/antora-diagram-engines#5fcae8cfd7a555e1021e2b081f50e3d78df44ca9&path:packages/diagram-lightbox",
    "@antora-supplemental/extension-lister": "github:antora-supplemental/extension-lister#v0.1.0",
    "@antora-supplemental/facto-stack": "link:.",
    "@antora-supplemental/link-validator": "github:antora-supplemental/link-validator#v0.2.2",
    "@antora-supplemental/linkinator": "github:antora-supplemental/linkinator#v0.1.10",
    "@antora-supplemental/mermaid-client": "github:antora-supplemental/antora-diagram-engines#5fcae8cfd7a555e1021e2b081f50e3d78df44ca9&path:packages/mermaid-client",
    "@antora-supplemental/nav-drift": "github:antora-supplemental/nav-drift#v0.1.2",
    "@antora-supplemental/nav-typology": "github:antora-supplemental/nav-typology#v0.1.11",
    "@antora-supplemental/nav-typology-diataxis": "github:antora-supplemental/nav-typology-diataxis#main",
    "@antora-supplemental/orphan-finder": "github:antora-supplemental/orphan-finder#v0.1.1",
    "@antora-supplemental/page-context": "github:antora-supplemental/page-context#v0.6.7",
    "@antora-supplemental/page-edit": "github:antora-supplemental/page-edit#v0.2.5",
    "@antora-supplemental/playbook-pin-auditor": "github:antora-supplemental/playbook-pin-auditor#v0.1.1",
    "@antora-supplemental/site-nav-tree": "github:antora-supplemental/site-nav-tree#v0.6.8",
    "@antora-supplemental/soft-nav-page-toc": "github:antora-supplemental/soft-nav-page-toc#v0.1.6",
    "@antora-supplemental/stale-page": "github:antora-supplemental/stale-page#v0.1.1",
    "@antora-supplemental/triage-ux-kit": "github:antora-supplemental/triage-ux-kit#v0.1.0",
    "@antora-supplemental/unversioned-component-urls": "github:antora-supplemental/antora-unversioned-component-urls#v2.1.2",
    "@antora/lunr-extension": "^1.0.0-alpha.13",
    "@antora/user-require-helper": "^3.0.0",
    "antora": "^3.1.14",
    "asciidoctor-emoji": "^0.5.0",
    "asciidoctor-kroki": "^0.18.1"
  },
  "devDependencies": {
    "@dev-centr/mermaid-svg-css-vars": "0.1.2",
    "@dev-centr/plantuml-svg-css-vars": "github:dev-centr/plantuml-svg-css-vars#v0.1.2",
    "@dev-centr/themed-svg": "0.1.1",
    "@mermaid-js/mermaid-cli": "11.17.0",
    "http-server": "^14.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer",
      "@dev-centr/plantuml-svg-css-vars"
    ]
  },
  "packageManager": "pnpm@10.28.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/antora-supplemental/facto-stack.git"
  },
  "homepage": "https://antora-supplemental.github.io/facto-stack/",
  "bugs": {
    "url": "https://github.com/antora-supplemental/facto-stack/issues"
  }
}
