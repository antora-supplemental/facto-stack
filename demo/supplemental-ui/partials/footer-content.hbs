<footer class="footer">
  {{> footer-build-stack}}
  <p>
    Built with <a href="https://antora.org" target="_blank" rel="noopener">Antora</a>{{#if antoraVersion}} <span class="antora-version">({{antoraVersion}})</span>{{/if}}.
    UI:
    {{#if site.keys.uiBundleName}}
    <a href="{{site.keys.uiBundleUrl}}" target="_blank" rel="noopener">{{site.keys.uiBundleName}}</a>
    {{else}}
    <a href="https://github.com/antora-supplemental/valentus-theme" target="_blank" rel="noopener">valentus-theme</a>
    {{/if}}
    (MIT).
    Stack: <a href="https://github.com/antora-supplemental/facto-stack" target="_blank" rel="noopener">facto-stack</a>.
    {{#if site.keys.footerNote}} <span class="site-footer-note">{{{site.keys.footerNote}}}</span>{{/if}}
  </p>
</footer>
